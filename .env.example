# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-token-from-botfather

# Your numeric Telegram user ID(s), comma separated (ask @userinfobot). Admins get a message
# for every sale and can use /admin, /add, /stock, /price, /clear and /del.
ADMIN_IDS=123456789

# Your USDT receiving address on BNB Smart Chain (BEP20). Use a wallet only this shop uses:
# every USDT transfer into it is matched against orders, and unknown ones are reported to you.
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ---- Optional -------------------------------------------------------------------------------

# Flat fee in USDT added to every order, e.g. 0.2 (0 = no fee).
FEE_USDT=0

# Minutes a buyer has to pay (5-180). The item is reserved for them meanwhile.
PAYMENT_MINUTES=30

# Shown to buyers.
STORE_NAME=Digital Store
# Support @username (without @), shown in /help and when something needs a human.
SUPPORT_USERNAME=

# BSC JSON-RPC endpoints, comma separated, tried in order. They must allow eth_getLogs (the
# defaults do). The bsc-dataseed*.bnbchain.org nodes reject it and cannot detect payments.
BSC_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc.publicnode.com

# SQLite database file, created automatically.
DB_FILE=data/shop.db

# Proxy for reaching Telegram if your network blocks it, e.g. http://127.0.0.1:8080
TELEGRAM_PROXY=
