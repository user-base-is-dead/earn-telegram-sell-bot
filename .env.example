# Local SQLite database file. Relative paths resolve from where you start the
# bot (`python bot.py`), so this keeps the DB in a sibling folder; use
# data/store.db to keep it inside the project instead. Created automatically.
DB_PATH=../earn-seller-bot-db-main/store.db

# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Telegram numeric user IDs of admins (comma separated). Get yours from @userinfobot
ADMIN_IDS=123456789

# UPI details for receiving payments
UPI_ID=7077873615@kotakbank
UPI_PAYEE_NAME=Your Store Name

# Telegram @username buyers reach via the "Customer support" button (without @).
# Leave blank to open the first admin's profile by ID instead.
SUPPORT_USERNAME=

# Comma-separated @usernames of channels a user must join before using the bot
# (the bot must be an admin in each to check membership). Leave blank to disable
# the force-join check entirely. e.g. mychannel1,mychannel2
REQUIRED_CHANNELS=

# --- Crypto (optional) — set any/both to show a crypto payment option ---
# Your Binance Pay ID (numeric), e.g. 123456789
BINANCE_PAY_ID=
# Or a crypto deposit address (a QR is generated for this), e.g. a USDT-BEP20 (BSC) address
CRYPTO_ADDRESS=
# Coin / network label shown to the buyer
CRYPTO_NETWORK=USDT (BEP20)
# Flat fee (USDT) added on top of the product price for Binance Pay / crypto so
# you receive the full amount after network charges. e.g. product 6 -> buyer
# sends 6.2. Set to 0 to disable. Does NOT affect UPI.
CRYPTO_FEE_USDT=0.2

# --- Auto-confirmed wallet top-ups (optional) ---
# Set CRYPTO_ADDRESS above (a BSC/0x... address) to enable auto-confirmed USDT-BEP20
# top-ups. Public RPC endpoints polled for incoming transfers (comma separated,
# rotated on failure) — the defaults are fine for most people.
BSC_RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.defibit.io
# Read-only Binance API key/secret (Enable Reading only, no trading/withdrawal
# permission) to auto-detect incoming Binance Pay transfers. Leave blank to skip
# this top-up rail (BSC alone still works).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Daily ops digest (optional) ---
# UTC hour (0-23) the once-daily admin summary DM (sales, deposits, pending
# items) is sent. Default 20 (20:00 UTC).
DAILY_DIGEST_HOUR_UTC=20

# --- Premium custom emoji on buttons (optional) ---
# Requires the bot owner (whoever's account made this bot via @BotFather) to have
# an active Telegram Premium subscription (or the bot to own a Fragment username)
# — a Telegram platform requirement, not something this bot can work around.
# JSON object mapping a button key to a custom_emoji_id. To get real IDs: as an
# admin, send or forward a message containing the premium emoji you want to the
# bot — it replies with the ID to paste here. Leave blank/`{}` to show no icons
# (buttons keep their normal Unicode emoji either way).
# Keys used by app/keyboards.py (button icons): browse, myorders, topup, add,
# products, all_orders, users, broadcast, earnings, help, support, refresh,
# menu, prev, next, buy, out_of_stock, back, approve, reject, nopay, other,
# cancel, price, stock, name, description, keys, activate, deactivate, delete,
# profile, icon, product (the global default catalog/product-name icon — each
# product can override it with its own emoji via the "Icon" button in Manage,
# no .env edit needed)
# Keys used inline in message text via app/formatting.py's cemoji(): star, wave,
# cart, bolt, green, orange, cross, party, gift, new, restock, receipt, money,
# bank, chain, binance, warn, check, reject, announce, chat, plus, people,
# broom, search, info, pencil, clipboard, trash, person, id, mouse, calendar,
# chart, pray, key, edit, back, cancel_x, block, megaphone, bell, up, down,
# point_down, point_down_start, point_right, point_up, step1, step2, step3,
# step4, step5 (the numbered /help buying steps)
CUSTOM_EMOJI_IDS={}

# --- Network (optional) ---
# Proxy for reaching Telegram when your ISP blocks api.telegram.org.
# Examples:  http://127.0.0.1:8080   or   socks5://127.0.0.1:1080
# (socks proxies also need:  pip install "python-telegram-bot[socks]")
TELEGRAM_PROXY=
# Seconds to wait when connecting to Telegram (default 20).
CONNECT_TIMEOUT=20
# How many times to retry the initial connection before giving up (default 5).
STARTUP_RETRIES=5
